# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Resend API key for sending email inquiries
RESEND_API_KEY="re_123456789"

# CONTACT_EMAIL: Target inbox for contact form submissions (e.g. contact@salkintech.com)
CONTACT_EMAIL="contact@salkintech.com"

# VITE_GA_MEASUREMENT_ID / GA_MEASUREMENT_ID: Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# FIREBASE_API_KEY / VITE_FIREBASE_API_KEY: Web API key for Firebase Authentication & Google Workspace OAuth
FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_API_KEY="AIzaSy..."
